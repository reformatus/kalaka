{
	"name": "kalaka",
	"private": true,
	"scripts": {
		"env": "wp-env",
		"build": "wp-scripts build --experimental-modules --webpack-copy-php --source-path=plugins/kalaka/src --output-path=plugins/kalaka/build --webpack--devtool=source-map",
		"start": "wp-scripts start --experimental-modules --webpack-copy-php --source-path=plugins/kalaka/src --output-path=plugins/kalaka/build --webpack--devtool=source-map",
		"lint:js": "wp-scripts lint-js plugins/kalaka/src plugins/kalaka/tests/js",
		"test:js": "wp-scripts test-unit-jest"
	},
	"devDependencies": {
		"@babel/core": "7.29.0",
		"@eslint/js": "9.39.5",
		"@wordpress/babel-preset-default": "10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/interactivity": "6.40.0",
		"@wordpress/scripts": "37.0.0",
		"@wp-playground/cli": "3.1.60",
		"babel-jest": "30.5.0",
		"jest": "30.5.0",
		"jest-environment-jsdom": "30.5.0"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"testMatch": [
			"<rootDir>/plugins/kalaka/tests/js/**/*.test.js"
		],
		"moduleNameMapper": {
			"^@wordpress/interactivity$": "<rootDir>/node_modules/@wordpress/interactivity/build-module/index.mjs"
		},
		"transform": {
			"\\.m?[jt]sx?$": "<rootDir>/plugins/kalaka/tests/js/transform.cjs"
		},
		"transformIgnorePatterns": [
			"/node_modules/(?!@wordpress/interactivity/)"
		],
		"testEnvironmentOptions": {
			"customExportConditions": [
				"node",
				"node-addons"
			]
		},
		"setupFiles": [
			"<rootDir>/plugins/kalaka/tests/js/setup.js"
		]
	}
}
