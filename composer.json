{
    "name": "kalaka/dev",
    "description": "Development tooling for the Kaláka repository",
    "type": "project",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "deptrac/deptrac": "^4.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0",
        "brianhenryie/strauss": "0.31.1"
    },
    "autoload-dev": {
        "psr-4": {
            "KalakaDev\\Deptrac\\": "bin/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "deptrac": "deptrac analyse --fail-on-uncovered",
        "phpcs": "phpcs"
    }
}
